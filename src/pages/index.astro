---
import AlbumCard from "../components/AlbumCard.astro";
import PageHeader from "../components/PageHeader.astro";
import Page from "../layouts/Page.astro";
import { formatYears } from "../lib/dates";
import { isListed, loadGallery } from "../lib/gallery";
import { socialImage } from "../lib/images";
import { AUTHOR, SEPARATOR, SITE_TITLE } from "../site";

const { albums, collections } = await loadGallery();
const listedAlbums = albums.filter(isListed);
const listedCollections = collections.filter(isListed);
const latest = listedAlbums[0];
// The years the listed albums cover, such as "2023–2026".
const years = formatYears(listedAlbums.flatMap((album) => album.dates ?? []));
---

<Page
  description={`Travel and everyday photos by ${AUTHOR}, ${years}.`}
  image={
    latest && {
      ...(await socialImage(latest.cover.image)),
      alt: latest.cover.alt,
    }
  }
>
  <main>
    <PageHeader
      title={SITE_TITLE}
      subtitle={`Selected work${SEPARATOR}${years}`}
    >
      {listedCollections.length > 0 && (
        <nav aria-label="Collections">
          {listedCollections.map((collection) => (
            <a href={`/${collection.id}/`}>{collection.title}</a>
          ))}
        </nav>
      )}
    </PageHeader>
    <div class="grid">
      {listedAlbums.map((album, index) => (
        <AlbumCard album={album} eager={index < 3} />
      ))}
    </div>
  </main>
</Page>

<style>
  main {
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: 24px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 20px;
    margin-top: 8px;
  }

  nav a {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
    transition: opacity 0.15s ease;
  }

  nav a:hover {
    opacity: 1;
  }

  /* Columns at least 310px wide, or the full width on narrow phones. The third of the width keeps it to three columns. */
  .grid {
    --gap: clamp(8px, 1.5vw, 18px);
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(max(min(100%, 310px), (100% - 2 * var(--gap)) / 3), 1fr)
    );
    gap: var(--gap);
  }
</style>
