---
import AlbumCard from "../components/AlbumCard.astro";
import Page from "../layouts/Page.astro";
import { formatMonths, formatYears } from "../lib/dates";
import { type PhotoSet, isListed, loadGallery } from "../lib/gallery";
import { socialImage } from "../lib/images";
import { AUTHOR, SITE_TITLE } from "../site";

const { albums, collections } = await loadGallery();
const listedAlbums = albums.filter(isListed);
const listedCollections = collections.filter(isListed);
const latest = listedAlbums[0];
// The years the listed albums cover, such as "2023–2026".
const years = formatYears(listedAlbums.flatMap((album) => album.dates ?? []));

const count = (photoSet: PhotoSet) =>
  `${photoSet.photos.length} ${photoSet.photos.length === 1 ? "photo" : "photos"}`;
const join = (parts: (string | undefined)[]) =>
  parts.filter(Boolean).join(" · ");

const collectionCards = listedCollections.map((collection) => ({
  photoSet: collection,
  details: count(collection),
}));

// Albums under the year they started in, newest first, as loadGallery sorts them.
const albumsByYear = Map.groupBy(listedAlbums, (album) =>
  album.dates![0].slice(0, 4),
);
const yearSections = [...albumsByYear].map(([year, yearAlbums]) => ({
  title: year,
  cards: yearAlbums.map((album) => ({
    photoSet: album,
    details: join([album.country, formatMonths(...album.dates!), count(album)]),
  })),
}));

// The latest album comes first, since most visitors are there for it. The latest year's albums are the biggest, and
// the collections come last and small, since they're mostly reached by their own links.
const sections = [
  ...yearSections.map((section, index) => ({
    ...section,
    size: index === 0 ? "large" : "medium",
  })),
  ...(collectionCards.length > 0
    ? [{ title: "Collections", cards: collectionCards, size: "small" }]
    : []),
];
// Load the covers of the first few cards straight away, since they start on screen.
let cardIndex = 0;
---

<Page
  description={`Travel and everyday photos by ${AUTHOR}, ${years}.`}
  image={
    latest && {
      ...(await socialImage(latest.cover.image)),
      alt: latest.cover.alt,
    }
  }
>
  <main>
    <h1 class="sr-only">{SITE_TITLE}</h1>
    {sections.map((section) => (
      <section
        class:list={[
          section.size,
          { collections: section.cards === collectionCards },
        ]}
        aria-labelledby={`section-${section.title}`}
      >
        <h2 id={`section-${section.title}`}>{section.title}</h2>
        <div class="row">
          {section.cards.map(({ photoSet, details }) => (
            <AlbumCard
              album={photoSet}
              details={details}
              eager={cardIndex++ < 4}
            />
          ))}
        </div>
      </section>
    ))}
  </main>
</Page>

<style>
  main {
    --gap: clamp(8px, 1.2vw, 16px);
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: clamp(16px, 2.5vw, 32px) clamp(16px, 2.5vw, 40px) 64px;
  }

  /* The heading sits in a column on the left, and stays in view while its albums scroll past. */
  section {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: var(--gap);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .collections {
    padding-top: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--surface);
  }

  h2 {
    position: sticky;
    top: 16px;
    align-self: start;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  @media (max-width: 599px) {
    section {
      grid-template-columns: minmax(0, 1fr);
    }

    h2 {
      position: static;
    }

    /* Albums take the full width on phones, but collections stay smaller, two to a row. */
    .small .row > :global(.card) {
      flex-basis: calc(50% - var(--gap) / 2);
      max-width: calc(50% - var(--gap) / 2);
    }
  }

  /*
   * Rows of covers that keep their own shapes. Each card starts --row-height tall and grows in proportion to its
   * ratio, so every cover in a row is the same height and the row fills the width. Cards stop growing at
   * --max-row-height, so a row with only one or two covers doesn't blow up; the filler takes what's left.
   */
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--gap) * 2) var(--gap);
  }

  .large .row {
    --row-height: clamp(200px, 20vw, 380px);
    --max-row-height: calc(var(--row-height) * 1.8);
  }

  .medium .row {
    --row-height: clamp(170px, 17vw, 320px);
    --max-row-height: calc(var(--row-height) * 1.8);
  }

  .small .row {
    --row-height: clamp(110px, 10vw, 180px);
    --max-row-height: var(--row-height);
  }

  .row::after {
    content: "";
    flex: 0.001 1 0;
  }
</style>
