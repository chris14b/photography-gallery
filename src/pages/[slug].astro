---
import type { GetStaticPaths } from "astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoStream from "../components/PhotoStream.astro";
import Page from "../layouts/Page.astro";
import { formatShortDates } from "../lib/dates";
import { type PhotoSet, countPhotos, loadGallery } from "../lib/gallery";
import { averageColour, coverSource, socialImage } from "../lib/images";
import { SEPARATOR } from "../site";

interface Props {
  photoSet: PhotoSet;
  /** The albums just before and after this one, for an album. */
  earlier?: PhotoSet;
  later?: PhotoSet;
  /** Every collection, in the home page's order, for a collection's footer. */
  collections?: PhotoSet[];
}

// Albums and collections share the top level of the URL; loadGallery fails the build if a collection clashes with an album.
export const getStaticPaths = (async () => {
  const { albums, collections } = await loadGallery();
  return [
    // Newest first, as loadGallery sorts them.
    ...albums.map((album, index) => ({
      params: { slug: album.id },
      props: {
        photoSet: album,
        earlier: albums[index + 1],
        later: albums[index - 1],
      },
    })),
    ...collections.map((collection) => ({
      params: { slug: collection.id },
      props: { photoSet: collection, collections },
    })),
  ];
}) satisfies GetStaticPaths;

const { photoSet, earlier, later, collections = [] } = Astro.props;
const { title, subtitle, description, photos, cover } = photoSet;
const details = [subtitle, countPhotos(photoSet)]
  .filter(Boolean)
  .join(SEPARATOR);

// The albums either side, each with a small copy of its cover. Later comes first, so the footer runs newest to oldest
// from left to right, as the home page does.
const neighbours = await Promise.all(
  (
    [
      ["Later", later],
      ["Earlier", earlier],
    ] as const
  ).map(async ([label, album]) =>
    album
      ? {
          label,
          album,
          dates: album.dates && formatShortDates(...album.dates),
          source: await coverSource(album.cover.image),
          colour: await averageColour(album.cover),
          ratio: album.cover.image.width / album.cover.image.height,
        }
      : undefined,
  ),
);
const isAlbum = photoSet.dates !== undefined;
---

<Page
  title={title}
  description={description}
  image={{ ...(await socialImage(cover.image)), alt: cover.alt }}
>
  <main>
    <PageHeader title={title} subtitle={details} />
    <PhotoStream photos={photos} />
    <footer>
      {isAlbum ? (
        <nav class="albums" aria-label="More albums">
          {neighbours.map(
            (neighbour) =>
              neighbour && (
                <a
                  class:list={["neighbour", neighbour.label.toLowerCase()]}
                  href={`/${neighbour.album.id}/`}
                >
                  <img
                    src={neighbour.source.src}
                    width={neighbour.source.width}
                    height={neighbour.source.height}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    style={`--ratio: ${neighbour.ratio.toFixed(4)}; --colour: ${neighbour.colour}`}
                  />
                  <span class="label">
                    {neighbour.label === "Later" ? "← Later" : "Earlier →"}
                  </span>
                  <span class="title">{neighbour.album.title}</span>
                  {neighbour.dates && (
                    <span class="dates">{neighbour.dates}</span>
                  )}
                </a>
              ),
          )}
          <a class="all" href="/">
            All albums
          </a>
        </nav>
      ) : (
        <nav class="collections" aria-label="More photos">
          {/* Not in any order, so just their names, with this one marked. A list of one would only be this one. */}
          {collections.length > 1 && (
            <div class="set">
              <span class="label">Collections</span>
              <ul>
                {collections.map((collection, index) => (
                  <li>
                    {index > 0 && <span aria-hidden="true">{SEPARATOR}</span>}
                    <a
                      class="collection"
                      href={`/${collection.id}/`}
                      aria-current={
                        collection.id === photoSet.id ? "page" : undefined
                      }
                    >
                      {collection.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <a class="all" href="/">
            All albums
          </a>
        </nav>
      )}
    </footer>
  </main>
</Page>

<style>
  main {
    padding-bottom: 48px;
  }

  footer {
    margin: 96px clamp(16px, 2.5vw, 40px) 0;
    padding-top: 24px;
    border-top: 1px solid var(--surface);
  }

  /* The way home sits between the two albums, level with their labels, and drops below them on phones. */
  .albums {
    --cover-height: clamp(80px, 10vw, 140px);
    display: grid;
    grid-template-areas: "later all earlier";
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
  }

  @media (max-width: 599px) {
    .albums {
      grid-template-areas:
        "later earlier"
        "all all";
      grid-template-columns: 1fr 1fr;
    }
  }

  .neighbour {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  /* Each only as wide as its cover and text, so the cover keeps its shape rather than stretching across the column. */
  .later {
    grid-area: later;
    justify-self: start;
    align-items: flex-start;
  }

  .earlier {
    grid-area: earlier;
    justify-self: end;
    align-items: flex-end;
    text-align: right;
  }

  /* Down past the covers, their 10px margin and the 2px gap, to the labels. */
  .albums .all {
    grid-area: all;
    justify-self: center;
    padding-top: calc(var(--cover-height) + 12px);
  }

  @media (max-width: 599px) {
    .albums .all {
      padding-top: 0;
    }
  }

  .neighbour img {
    width: auto;
    height: var(--cover-height);
    aspect-ratio: var(--ratio);
    margin-bottom: 10px;
    object-fit: cover;
    background-color: var(--colour);
  }

  /* The way home sits level with the Collections label, on the right even when there's no list. */
  .collections {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  .collections .all {
    margin-left: auto;
  }

  .set {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  ul {
    list-style: none;
  }

  li {
    display: inline;
  }

  li > span {
    color: var(--muted);
  }

  .label,
  .dates,
  .all {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .title,
  .collection {
    font-weight: 500;
  }

  .collection[aria-current] {
    color: var(--muted);
  }

  .neighbour:hover .title,
  .collection:not([aria-current]):hover,
  .all:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .neighbour:focus-visible,
  .collection:focus-visible,
  .all:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
</style>
