---
import type { GetStaticPaths } from "astro";
import PageHeader from "../components/PageHeader.astro";
import PhotoStream from "../components/PhotoStream.astro";
import Page from "../layouts/Page.astro";
import { type PhotoSet, loadGallery } from "../lib/gallery";
import { socialImage } from "../lib/images";

type Props = PhotoSet;

// Albums and collections share the top level of the URL; loadGallery fails the build if a collection clashes with an album.
export const getStaticPaths = (async () => {
  const { albums, collections } = await loadGallery();
  return [...albums, ...collections].map((photoSet) => ({
    params: { slug: photoSet.id },
    props: photoSet,
  }));
}) satisfies GetStaticPaths;

const { title, subtitle, description, photos, cover } = Astro.props;

// A collection with no photos is hidden, and its URL goes home. A 301 makes the generated page redirect straight away.
if (photos.length === 0) return Astro.redirect("/", 301);
---

<Page
  title={title}
  description={description}
  image={cover && { ...(await socialImage(cover.image)), alt: cover.alt }}
  homeButton
>
  <main>
    <PageHeader title={title} subtitle={subtitle} />
    <PhotoStream photos={photos} />
  </main>
</Page>

<style>
  main {
    padding: 24px 0;
  }
</style>
