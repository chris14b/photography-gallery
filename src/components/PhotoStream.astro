---
import type { Photo } from "../lib/gallery";
import { averageColour, photoSources } from "../lib/images";
import LocationIcon from "./LocationIcon.astro";

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

// Portrait photos take turns having their caption on the right and the left.
let portraits = 0;
const items = await Promise.all(
  photos.map(async (photo) => {
    const { width, height } = photo.image;
    const portrait = width < height;
    const flip = portrait && portraits++ % 2 === 1;
    return {
      photo,
      portrait,
      flip,
      ratio: width / height,
      colour: await averageColour(photo),
      sources: await photoSources(photo.image),
    };
  }),
);
---

<!--
  One photo per screen, as large as fits. Each photo is sized from its aspect ratio (--ratio), so the layout needs no
  script, and filled with its average colour (--colour) while it loads. Portrait photos have their caption beside them
  on wide landscape screens; everything else has it below.
-->
<div class="stream">
  {items.map(({ photo, portrait, flip, ratio, colour, sources }, index) => (
    <figure
      class:list={["photo", { portrait, flip }]}
      style={`--ratio: ${ratio.toFixed(4)}; --colour: ${colour}`}
    >
      <img
        src={sources.src}
        srcset={sources.srcset}
        sizes={`min(100vw, 1600px, ${Math.round(ratio * 100)}vh)`}
        width={photo.image.width}
        height={photo.image.height}
        alt={photo.alt}
        loading={index === 0 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : undefined}
        decoding="async"
      />
      {(photo.caption || photo.location) && (
        <figcaption>
          {photo.caption && <span class="caption">{photo.caption}</span>}
          {photo.location && (
            <span class="location">
              <LocationIcon />
              {photo.location}
            </span>
          )}
        </figcaption>
      )}
    </figure>
  ))}
</div>

<style>
  .stream {
    display: flex;
    flex-direction: column;
    gap: 96px;
  }

  .photo {
    /* No gutter on phones, growing to 40px on wide screens. */
    --gutter: clamp(0px, 2.5vw - 10px, 40px);
    --caption-width: 300px;
    --caption-gap: 32px;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  img {
    /* Leave room below the photo for its caption. */
    width: min(
      100% - 2 * var(--gutter),
      1600px,
      (100svh - 6rem) * var(--ratio)
    );
    background-color: var(--colour);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 4px 14px;
    padding: 0 24px;
    text-align: center;
  }

  .caption {
    font-size: var(--font-size-lg);
    font-weight: 500;
  }

  /*
   * Lined up by the text rather than centred, so the location takes its baseline from its text and sits level with the
   * caption. Otherwise it takes it from the bottom of the pin and sits higher.
   */
  .location {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--muted);
  }

  .location :global(svg) {
    align-self: center;
    width: 13px;
    height: 13px;
  }

  @media (min-width: 768px) and (orientation: landscape) {
    .portrait {
      flex-direction: row;
      justify-content: center;
      gap: var(--caption-gap);
    }

    .portrait.flip {
      flex-direction: row-reverse;
    }

    .portrait img {
      flex: none;
      width: min(
        100% - 2 * var(--gutter) - var(--caption-width) - var(--caption-gap),
        (100svh - 48px) * var(--ratio)
      );
    }

    .portrait figcaption {
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      gap: 8px;
      max-width: var(--caption-width);
      padding: 0;
      text-align: left;
    }

    .portrait.flip figcaption {
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
