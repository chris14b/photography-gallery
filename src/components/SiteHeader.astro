---
import { AUTHOR } from "../site";
import FullscreenButton from "./FullscreenButton.astro";

const home = Astro.url.pathname === "/";
const about = Astro.url.pathname.replace(/\/$/, "") === "/about";
// Album and collection pages, which are the only long scrolls through photos.
const photoPage = Astro.routePattern === "/[slug]";
---

<!--
  The same on every page: the name goes home, which is how a shared collection link leads to everything else. On album
  and collection pages it gets out of the way as you scroll down through the photos and comes back when you scroll up,
  so home is never far. Elsewhere it stays put at the top: the home page's year headings already stick there, and the
  about and 404 pages are short enough not to need it.
-->
<header class:list={{ "comes-back": photoPage }}>
  <a class="name" href="/" aria-current={home ? "page" : undefined}>
    {AUTHOR} <span class="kind">Photography</span>
  </a>
  <div class="links">
    <a class="about" href="/about/" aria-current={about ? "page" : undefined}>
      About
    </a>
    <FullscreenButton />
  </div>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    /* The fullscreen button's height, so the header doesn't shrink where the button is hidden. */
    min-height: 36px;
    margin: 16px clamp(16px, 2.5vw, 40px) 0;
  }

  /*
   * Padding rather than margin, so the background covers the photos edge to edge. The extra 12px underneath is taken
   * back with a negative margin, so the page starts where it would without it.
   */
  .comes-back {
    position: sticky;
    top: 0;
    z-index: 1;
    margin: 4px 0 -12px;
    padding: 12px clamp(16px, 2.5vw, 40px);
    background-color: var(--background);
  }

  /* Tabbing into it brings it back, so keyboard users never focus something they can't see. */
  .comes-back.hidden:not(:focus-within) {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .comes-back {
      transition: transform 0.25s ease;
    }
  }

  .name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  /* Says what the site is, for someone arriving from a shared link, without making the name any bigger. */
  .kind {
    font-weight: 400;
    color: var(--muted);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .about {
    font-size: 0.9rem;
    color: var(--muted);
    transition: color 0.15s ease;
  }

  .about:hover,
  .about[aria-current] {
    color: var(--text);
  }

  .name:focus-visible,
  .about:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }
</style>

<script>
  const header = document.querySelector("header.comes-back");
  if (header) {
    // How far the page has to move before the header follows, so a wobble of the finger doesn't flick it in and out.
    const threshold = 8;
    let last = window.scrollY;
    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        // At the top, including iOS's bounce above it, the header is back in its own place.
        if (y <= 0) {
          header.classList.remove("hidden");
        } else if (Math.abs(y - last) < threshold) {
          return;
        } else {
          header.classList.toggle("hidden", y > last);
        }
        last = y;
      },
      { passive: true },
    );
  }
</script>
