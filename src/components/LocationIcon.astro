---
// A map pin to put before a location, in the style of the other 16×16 round-stroke icons. Its lines are thinner, as it's
// drawn smaller, beside small text, and its dot is solid so it doesn't run into the outline.
---

<svg
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  role="img"
  aria-label="Location"
>
  <path
    d="M8 1.5C5.514 1.5 3.5 3.514 3.5 6c0 3.25 4.5 8.5 4.5 8.5S12.5 9.25 12.5 6C12.5 3.514 10.486 1.5 8 1.5Z"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <circle cx="8" cy="6" r="1.5" fill="currentColor"></circle>
</svg>

<style>
  svg {
    flex: none;
  }
</style>
