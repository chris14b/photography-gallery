---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header>
  <h1>{title}</h1>
  {subtitle && <p>{subtitle}</p>}
  <slot />
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 100%;
    padding: 16px 24px 12px;
    margin-bottom: 16px;
    text-align: center;
  }

  @media (min-width: 768px) {
    header {
      gap: 6px;
      padding: 18px 24px 14px;
    }
  }

  h1 {
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }

  p {
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    line-height: 1.3;
    opacity: 0.75;
  }
</style>
