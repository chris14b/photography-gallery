---
interface Props {
  title: string;
  /** A line of details under the title, such as "Indonesia · July–August 2024 · 24 photos". */
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="page-header">
  <h1>{title}</h1>
  {subtitle && <p>{subtitle}</p>}
</div>

<style>
  .page-header {
    margin: clamp(24px, 4vw, 48px) 24px clamp(24px, 3vw, 40px);
    text-align: center;
  }

  h1 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  p {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
