---
import type { PhotoSet } from "../lib/gallery";
import { coverPreview } from "../lib/images";

interface Props {
  album: PhotoSet;
  /** The line under the title, such as "Indonesia · Sep–Oct · 10 photos". */
  details: string;
  /** Load the cover straight away, for cards that start on screen. */
  eager?: boolean;
}

const { album, details, eager = false } = Astro.props;
const { cover } = album;
const { source, colour, ratio } = await coverPreview(cover);
---

<!-- Sized by --ratio within a row of cards, so its cover keeps its own shape. See .row in index.astro, which sets the row heights. -->
<a
  class="card"
  href={`/${album.id}/`}
  style={`--ratio: ${ratio.toFixed(4)}; --colour: ${colour}`}
>
  <div class="frame">
    <img
      src={source.src}
      width={source.width}
      height={source.height}
      alt={cover.alt}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </div>
  <h3>{album.title}</h3>
  <p>{details}</p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    /* Growing in proportion to the ratio keeps every cover in a row the same height. */
    flex: var(--ratio) 1 calc(var(--ratio) * var(--row-height));
    min-width: 0;
    max-width: calc(var(--ratio) * var(--max-row-height));
  }

  @media (max-width: 599px) {
    .card {
      flex-basis: 100%;
      max-width: none;
    }
  }

  .frame {
    overflow: hidden;
    aspect-ratio: var(--ratio);
    /* The cover's average colour, while it loads. */
    background-color: var(--colour);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    img {
      transition: transform 0.4s ease;
    }

    .card:hover img {
      transform: scale(1.03);
    }
  }

  .card:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  h3 {
    margin-top: 10px;
    font-size: var(--font-size-md);
    font-weight: 500;
    line-height: 1.3;
  }

  p {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--muted);
  }
</style>
