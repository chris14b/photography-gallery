---
import type { Album } from '../lib/gallery'
import { coverSource } from '../lib/images'

interface Props {
  album: Album
  /** Load the cover straight away, for cards that start on screen. */
  eager?: boolean
}

const { album, eager = false } = Astro.props
const cover = await coverSource(album.cover.image)
---

<a class="card" href={`/${album.id}/`}>
  <div class="frame">
    <img
      src={cover.src}
      width={cover.width}
      height={cover.height}
      alt={album.cover.alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <div class="text">
    <h2>{album.title}</h2>
    {album.subtitle && <p>{album.subtitle}</p>}
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* The shadow fades in on a pseudo-element so hovering doesn't animate box-shadow. */
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    opacity: 0;
    pointer-events: none;
  }

  .frame {
    overflow: hidden;
    width: 100%;
    aspect-ratio: 3 / 2;
    background-color: var(--surface);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card,
    .card::after,
    img {
      transition:
        transform 0.3s ease,
        opacity 0.3s ease;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .card:hover::after {
      opacity: 1;
    }

    .card:hover img {
      transform: scale(1.05);
    }
  }

  .card:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .text {
    padding: 10px 12px;
    text-align: center;
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 600;
  }

  p {
    margin-top: 4px;
    font-size: 0.95rem;
    opacity: 0.85;
  }
</style>
