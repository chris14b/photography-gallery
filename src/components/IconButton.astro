---
import type { HTMLAttributes } from "astro/types";

type Props = Pick<HTMLAttributes<"button">, "id" | "hidden"> & {
  label: string;
};

const { label, ...rest } = Astro.props;
---

<button
  class="icon-button"
  type="button"
  aria-label={label}
  title={label}
  {...rest}
>
  <slot />
</button>

<style>
  .icon-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background-color: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .icon-button[hidden] {
    display: none;
  }

  .icon-button:hover {
    background-color: var(--surface);
    color: var(--text);
  }

  .icon-button:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
</style>
