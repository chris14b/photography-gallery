---
import type { HTMLAttributes } from "astro/types";

type Props = Pick<HTMLAttributes<"button">, "id" | "hidden"> & {
  /** Which top corner of the screen the button floats in. */
  corner: "left" | "right";
  href?: string;
  label: string;
};

const { corner, href, label, ...rest } = Astro.props;
---

{href ? (
  <a
    class:list={["icon-button", corner]}
    href={href}
    aria-label={label}
    title={label}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    class:list={["icon-button", corner]}
    type="button"
    aria-label={label}
    title={label}
    {...rest}
  >
    <slot />
  </button>
)}

<style>
  .icon-button {
    position: fixed;
    top: 20px;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background-color: var(--accent);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      box-shadow 0.2s ease;
  }

  .icon-button[hidden] {
    display: none;
  }

  .left {
    left: 20px;
  }

  .right {
    right: 20px;
  }

  .icon-button:hover {
    background-color: var(--surface);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .icon-button:active {
    filter: brightness(0.95);
  }

  .icon-button:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
</style>
